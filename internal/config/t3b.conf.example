# Example t3b config. Meat Bags: edit real values before connecting.
# Write a fresh copy with: t3b -config_write   (or: t3b -config_write mybot.conf)
# Default pickup: any file in $PWD ending with t3b.conf (exactly one). Override: t3b -config path
#
# Top-level keys must come before [tables] — otherwise TOML nests them wrongly.

# One network only; join as many channels as you need.
channels = ["#t3b"]

# Hostmasks look like: nick!~user@host.name
owner = "tew!~tew@example.host"
admins = [
  # "admin!~admin@example.host",
]

[server]
host = "irc.example.net"
port = 6697
tls = true
# Set true only for lab/self-signed nets — never on production networks.
tls_skip_verify = false

[identity]
nick = "t3b"
user = "t3b"
realname = "tew's irc bot"

# Prefer TLS when using PLAIN (t3b warns if sasl.enabled and tls = false).
[sasl]
enabled = false
mechanism = "PLAIN"
user = ""
password = ""

[runtime]
# Empty → platform default: Unix $PWD/t3b.sock , Windows \\.\pipe\t3b
socket_path = ""
# Empty → $PWD/t3b.pid for t3b.conf; otherwise <config-basename>.pid (e.g. bot.t3b.conf → bot.t3b.pid)
pid_path = ""

[resolve]
url_titles = true
twitter = true
youtube = true
reddit = true
# Data API v3 key (YouTube Data API). Empty → YouTube links get a plain page title.
# youtube_api_key = ""
# Reddit: Arctic Shift archive (score/date/sub) + oEmbed fallback. No API key.
# Reddit HTML/.json often 403 from datacenter IPs; downs are not public.
# Omit user_agent to use the binary build version (t3b/<hash or tag-hash>).
# user_agent = "t3b/custom (+https://example.com)"
http_timeout_sec = 8

[automode]
enabled = true
